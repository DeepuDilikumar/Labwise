{
  "name": "labwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "screens": "tsx scripts/screens.ts",
    "eval": "LABWISE_MODE=local tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval-golden.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "fixtures": "tsx scripts/fixtures/generate.ts",
    "content": "python3 scripts/content/markers.py",
    "review-list": "python3 scripts/content/review_list.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@electric-sql/pglite": "0.5.16",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.17",
    "lucide-react": "1.75.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.11.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@10.28.0"
