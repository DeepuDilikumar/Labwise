# ---- Mode ----
# local: zero-key mode (PGlite in .data/, encrypted local files, dev OTP, fixture AI, fake payments)
# cloud: Supabase + Anthropic + Razorpay
LABWISE_MODE=local
APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION=in

# Required in cloud mode. Generate with: openssl rand -hex 32
SESSION_SECRET=
STORAGE_ENCRYPTION_KEY=

# ---- Supabase (cloud) ----
# Use the pooled connection string (Settings → Database → Connection pooling, transaction mode).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ---- AI ----
# With a key, extraction/explanations use Anthropic; without one, only bundled sample reports can be read.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Payments (India) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated emails/phones allowed to view /admin/costs
ADMIN_EMAILS=
